<?xml version="1.0" encoding="utf-8"?>
<!-- ELITE dashboard card chrome — black base, gold border, subtle purple glow ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/elite_bg"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#1c1424"
                android:endColor="#07050c"
                android:angle="135"
                android:type="linear"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="2dp" android:color="@color/elite_glow"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/elite_card_border"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
