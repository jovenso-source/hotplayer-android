<?xml version="1.0" encoding="utf-8"?>
<!-- SELECT dashboard card chrome — same shape/base as bg_home_card, plus a subtle gold border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#181d2e"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#241f10"
                android:endColor="#111625"
                android:angle="135"
                android:type="linear"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/select_card_border"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
